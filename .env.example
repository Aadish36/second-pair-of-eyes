# Copy this file to .env and adjust values for your local environment.
# Mock mode requires no credentials. Set live mode and a real key only for local use;
# never commit a populated .env file.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MAX_SOURCE_CHARS=100000
AI_REVIEW_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HISTORY_REPO_PATH=
HISTORY_HOST_PATH=./history
HISTORY_MAX_COMMITS=500
CHROMA_PATH=.data/chroma
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/second_pair_of_eyes
POSTGRES_PASSWORD=
DASHBOARD_API_TOKEN=
DASHBOARD_COOKIE_SECURE=false
GITHUB_WEBHOOK_SECRET=<random-webhook-secret>
GITHUB_APP_ID=<github-app-id>
# Set exactly one private-key source. Keep private key material out of source control.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_REQUEST_TIMEOUT_SECONDS=20
GITHUB_MAX_RETRIES=3
FRONTEND_PORT=8080
